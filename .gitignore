# ==========================================
# Environment Variables
# ==========================================
.env
.env.local
.env.*.local

# Keep the template
!.env.example

# ==========================================
# Python Virtual Environments
# ==========================================
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# Python Cache
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# Test & Coverage
# ==========================================
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.tox/
.nox/

# ==========================================
# Temporary Application Files
# ==========================================
temp_audio/
data/summaries/
*.tmp
*.temp

# ==========================================
# Logs
# ==========================================
*.log

# ==========================================
# IDE & Editor
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# Build / Distribution
# ==========================================
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ==========================================
# Jupyter
# ==========================================
.ipynb_checkpoints/

# ==========================================
# Generated Audio & Videos
# ==========================================
*.mp3
*.wav
*.m4a

# Ignore generated videos everywhere
*.mp4

# But keep documentation/demo videos
# !docs/**/*.mp4

# ==========================================
# Generated Images (Optional)
# ==========================================
# Ignore screenshots generated by the app
# Uncomment if required
# *.png
# *.jpg

# Keep documentation images
# !docs/images/
# !docs/images/**
# !docs/*.png
# !docs/*.jpg
# !docs/*.jpeg
# !docs/*.gif

# ==========================================
# Keep Required Project Files
# ==========================================
!README.md
!requirements.txt
!main.py